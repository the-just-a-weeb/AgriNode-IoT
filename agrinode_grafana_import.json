{
 "title": "AgriNode field monitor",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "tags": [
  "agrinode"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Soil moisture",
   "datasource": {
    "type": "influxdb",
    "uid": "${DS_INFLUXDB}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_INFLUXDB}"
     },
     "refId": "A",
     "query": "from(bucket: \"agrinode\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"soil_pct\")\n  |> last()"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 20
       },
       {
        "color": "green",
        "value": 35
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
